# 运行时产物：文档 §6.6 规定的日志与运行记录目录，由程序自己创建
logs/
runs/

# 运行日志
*.log

# 场景 harness 的临时输出
tools/__pycache__/
*.pyc

# C 构建产物由 bridge/.gitignore 负责，这里不重复；这两条是按组员原有的命名习惯留的
bridge/*.o
bridge/bridge

# C# 构建产物
plugin/bin/
plugin/obj/

# 游戏目录是外部依赖：仓库只放插件源码和部署脚本，不提交游戏与 BepInEx 二进制
BepInEx/
winhttp.dll
doorstop_config.ini

# 本机游戏副本（2.77 GB，Unity 2017.4.8f1，仅供反编译与构建）
/Overcooked 2!/

# 本机编译依赖（游戏 / BepInEx / Unity DLL），不入库
plugin/Libs*/

# 布局编辑器保存时生成的备份与本地构建状态
levels/wellcooked_demo/*.tsv.bak*
levels/wellcooked_demo/layout-editor/build-status.txt

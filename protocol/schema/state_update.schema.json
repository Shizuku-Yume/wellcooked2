{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kitchenos:schema:state_update",
  "title": "state_update",
  "description": "插件 → Bridge：一帧世界状态。只有 type 是必填的，其余字段缺失（或为 null）时 Bridge 取默认值。数组上限是 C 侧固定布局的接收能力，超出部分被丢弃并计数，消息本身仍然可用。",
  "type": "object",
  "required": ["type"],
  "properties": {
    "type": { "const": "state_update" },
    "timestamp": {
      "type": "integer",
      "description": "Unix 秒。"
    },
    "game_time": {
      "type": "number",
      "description": "游戏内已进行秒数。"
    },
    "score": {
      "type": "number",
      "description": "当前分数。"
    },
    "chefs": {
      "type": "array",
      "maxItems": 16,
      "description": "每个厨师一格。没有整数 id 的条目会被单独丢弃并计数。",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 0,
            "description": "厨师编号，同时也是共享内存里的输入槽编号。"
          },
          "position": {
            "type": "object",
            "required": ["x", "y"],
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" }
            }
          },
          "holding": {
            "type": ["string", "null"],
            "description": "手上的东西；null 表示空手。"
          },
          "state": {
            "type": "string",
            "description": "取自游戏，例如 moving / idle。"
          }
        }
      }
    },
    "orders": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "description": "例如 order_001。" },
          "recipe": { "type": "string", "description": "例如 salad。" },
          "time_remaining": { "type": "number" },
          "ingredients": {
            "type": "array",
            "maxItems": 8,
            "items": { "type": "string" }
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "maxProperties": 48,
      "description": "键是动态的：pot_N、cutting_board_N、plate_stack，以及将来新增的键。认不出的键必须原样保留，不能因此拒绝整条消息。",
      "additionalProperties": { "$ref": "#/$defs/resource" },
      "propertyNames": {
        "description": "约定：pot_<N> / cutting_board_<N> / plate_stack。",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    }
  },
  "$defs": {
    "resource": {
      "type": "object",
      "description": "一个工位的状态。五个字段都可缺；has_time_left / has_chef_id / has_count 让 Bridge 区分『0』与『没上报』。",
      "properties": {
        "state": { "type": "string", "description": "free / occupied …" },
        "content": { "type": ["string", "null"], "description": "锅里在煮什么。" },
        "time_left": { "type": "number", "description": "剩余烹饪时间。" },
        "chef_id": { "type": "integer", "description": "占用该工位的厨师。" },
        "count": { "type": "integer", "minimum": 0, "description": "盘子数量（plate_stack）。" }
      }
    }
  }
}

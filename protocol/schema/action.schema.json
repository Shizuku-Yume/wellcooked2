{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wellcooked:schema:action",
  "title": "action",
  "description": "Bridge → 插件：让某个厨师做一件事。stop 是空转动作，输入槽缺失或超时时下发。",
  "type": "object",
  "required": ["type", "chef_id", "action"],
  "properties": {
    "type": { "const": "action" },
    "chef_id": {
      "type": "integer",
      "minimum": 0,
      "description": "目标厨师。"
    },
    "action": {
      "enum": ["move", "stop", "interact", "pickup", "dash", "path", "face", "work"],
      "description": "move 需要 target；interact/work 需要 target_object；path 需要 waypoints 与 seq；face 需要 target 或 target_object；stop / pickup / dash 不带附加字段。"
    },
    "target": {
      "type": "object",
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      },
      "description": "move/face 的目标坐标；face 与 target_object 二选一。"
    },
    "target_object": {
      "type": "string",
      "description": "interact/work 的目标，例如 cutting_board_0；face 可选，与 target 二选一。与 resources 的键同名。"
    },
    "button": { "type": "string", "description": "附加按键，插件透传给游戏。" },
    "hold_ms": { "type": "number", "description": "长按时长。" },
    "waypoints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["x", "y"],
        "properties": {
          "x": { "type": "number" },
          "y": { "type": "number" }
        }
      },
      "description": "path 动作的路点数组（1..8 项相邻格中心）。"
    },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "description": "path 动作的规划序号，同 seq 只追加路点。"
    }
  },
  "allOf": [
    {
      "if": { "properties": { "action": { "const": "move" } }, "required": ["action"] },
      "then": { "required": ["target"] }
    },
    {
      "if": { "properties": { "action": { "const": "interact" } }, "required": ["action"] },
      "then": { "required": ["target_object"] }
    },
    {
      "if": { "properties": { "action": { "const": "path" } }, "required": ["action"] },
      "then": { "required": ["waypoints", "seq"] }
    },
    {
      "if": { "properties": { "action": { "const": "face" } }, "required": ["action"] },
      "then": { "anyOf": [{ "required": ["target"] }, { "required": ["target_object"] }] }
    },
    {
      "if": { "properties": { "action": { "const": "work" } }, "required": ["action"] },
      "then": { "required": ["target_object"] }
    }
  ],
  "examples": [
    { "type": "action", "chef_id": 0, "action": "move", "target": { "x": 12, "y": 6 } },
    { "type": "action", "chef_id": 1, "action": "interact", "target_object": "cutting_board_0" },
    { "type": "action", "chef_id": 1, "action": "stop" },
    { "type": "action", "chef_id": 0, "action": "pickup" },
    { "type": "action", "chef_id": 1, "action": "dash" },
    { "type": "action", "chef_id": 0, "action": "path", "seq": 1, "waypoints": [
        { "x": 1.0, "y": 2.0 }, { "x": 1.0, "y": 3.0 }] },
    { "type": "action", "chef_id": 0, "action": "face", "target": { "x": 2.0, "y": 2.0 } },
    { "type": "action", "chef_id": 1, "action": "work", "target_object": "cutting_board_0" }
  ]
}

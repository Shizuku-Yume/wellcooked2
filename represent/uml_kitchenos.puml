@startuml KitchenOS_UseCase
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam defaultFontName Microsoft YaHei
actor "课程教师" as Teacher
actor "组员 / 开发者" as Dev
actor "游戏插件" as Game
rectangle "KitchenOS" {
  usecase "启动 / 停止系统" as UC1
  usecase "选择调度策略" as UC2
  usecase "接收订单与世界状态" as UC3
  usecase "拆解订单为工序DAG" as UC4
  usecase "分发任务给Worker" as UC5
  usecase "同步共享状态" as UC6
  usecase "监控心跳" as UC7
  usecase "异常重启业务进程" as UC8
  usecase "查看队列 / 锁 / 日志" as UC9
  usecase "注入故障并验证自愈" as UC10
}
Teacher --> UC9
Teacher --> UC10
Dev --> UC1
Dev --> UC2
Dev --> UC9
Game --> UC3
UC3 --> UC4
UC4 --> UC5
UC5 --> UC6
UC7 --> UC8
UC1 --> UC7
@enduml

@startuml KitchenOS_Component
skinparam componentStyle rectangle
skinparam shadowing false
skinparam defaultFontName Microsoft YaHei
component "Game / BepInEx" as Game
component "Bridge" as Bridge
component "Scheduler" as Scheduler
component "Worker 0" as W0
component "Worker 1" as W1
component "Supervisor" as Sup
database "Shared Memory" as Shm
queue "POSIX MQ" as Mq
collections "Semaphore / fcntl" as Lock
Game -down-> Bridge : TCP Socket\nworld state / frame input
Bridge -down-> Shm : write/read
Scheduler -down-> Mq : dispatch tasks
Mq -down-> W0
Mq -down-> W1
W0 -up-> Shm : action slot
W1 -up-> Shm : action slot
Sup ..> Bridge : heartbeat
Sup ..> Scheduler : SIGCHLD / restart
Sup ..> W0
Sup ..> W1
W0 ..> Lock
W1 ..> Lock
@enduml